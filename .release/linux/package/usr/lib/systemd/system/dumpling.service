[Unit]
Description="OpenDumpling - Identity-based access management for dynamic infrastructure"
Documentation=https://github.com/opendumpling/opendumpling/docs
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
EnvironmentFile=-/etc/dumpling.d/dumpling.env
User=dumpling
Group=dumpling
ProtectSystem=full
ProtectHome=read-only
ExecStart=/usr/bin/dumpling server -config=/etc/dumpling.d/dumpling.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
